{
    "id" : "io.github.nico359.simplesync",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "simplesync",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-download",
        "--filesystem=xdg-desktop",
        "--filesystem=xdg-pictures",
        "--filesystem=xdg-videos",
        "--filesystem=xdg-music"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "build-args" : [
            "--share=network"
        ],
        "env" : {
            "CARGO_HOME" : "/run/build/simplesync/cargo",
            "RUST_BACKTRACE" : "1"
        }
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "simplesync",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dbuildtype=release",
                "--libdir=lib"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/nico359/simplesync.git",
                    "tag" : "v1.2.0"
                }
            ]
        }
    ]
}
