{
    "id" : "io.github.nico359.camera",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "camera",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=all",
        "--system-talk-name=net.hadess.SensorProxy",
        "--filesystem=xdg-pictures/Camera:create",
        "--filesystem=xdg-videos/Camera:create",
        "--env=HYBRIS_LD_LIBRARY_PATH=/system/lib64:/vendor/lib64:/odm/lib64"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "build-args" : [
            "--share=network"
        ],
        "env" : {
            "RUST_BACKTRACE" : "1",
            "RUST_LOG" : "camera=debug"
        }
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "camera",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dbuildtype=release",
                "-Dcamera2=true"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/nico359/camera.git",
                    "tag" : "v0.1.0"
                }
            ]
        }
    ]
}
